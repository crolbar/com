---
import Head from "../components/Head.astro";
import Theme, { themeToCss } from "../lib/theme.ts";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
const { title = "crolbar" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} />
  </head>
  <body style={themeToCss(Theme)}>
    <div class="background-cont" />

    <div class="foreground-cont">
      <Navbar />
      <slot />
      <Footer />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    padding: 0;
    background-color: #1f1f1f;
    height: 100vh;
    color: #fdfdfd;
  }
  .background-cont {
    top: 0px;
    left: 0px;
    position: fixed;
    min-height: 100vh;
    height: 100%;
    width: 100%;
    z-index: 0;

    --size-w: 40px;
    --size-h: var(--size-w);

    background:
      radial-gradient(ellipse, var(--bg2) 15%, transparent 0%) top left /
        var(--size-w) var(--size-h) repeat,
      var(--bg);
  }
  .foreground-cont {
    display: flex;
    flex-direction: column;
    position: relative;
    place-items: center;
    z-index: 1;
    min-height: 100vh;
  }

  .foreground-cont > :global(footer) {
    margin-top: auto;
  }
</style>

---
import "../styles/global.css";
import Theme from "../lib/theme.ts";
import Layout from "../layouts/Root.astro";
import Board from "../components/Board.astro";
import Header from "../components/Header.astro";
import TeckStack from "../lib/tech-stack-info.ts";
import DiscordImg from "../images/discord-svg.astro";
import TwitterImg from "../images/twitter-svg.astro";
import LinkedInImg from "../images/linkedin-svg.astro";
import MailImg from "../images/mail-svg.astro";
import Data from "../lib/data.ts";
import {
  parseDate,
  getLatestThreePosts,
  getDaysAgoSince,
} from "../lib/posts.ts";
---

<Layout>
  <div id="content">
    <div>
      <Header className="hero-header" text="Hey there, 127.0.0.1" />
      <p
        style={{
          color: Theme.fg1,
          "text-align": "center",
          "max-width": "45rem",
        }}
      >
        {Data.profile}
      </p>
    </div>

    <div>
      <Header text="Contact" />

      <div class="contacts-cont">
        <Board class="contact-board">
          <MailImg />
          {Data.email}
        </Board>

        <Board class="contact-board">
          <TwitterImg />
          <a href={Data.twitter}>{Data.name}</a>
        </Board>
        <Board class="contact-board">
          <LinkedInImg />
          <a href={Data.linkedin}>crolbar1</a>
        </Board>

        <Board class="contact-board">
          <DiscordImg />
          <span>{Data.name}</span>
        </Board>
      </div>
    </div>

    <div style={{ width: "80%" }}>
      <Header text="Latest Posts" />
      <div class="latest-posts-cont">
        {getLatestThreePosts().map((p) => (
          <Board class="latest-posts-board">
            <div>
              <h2>
                <a href={p.url}>{p.frontmatter.title}</a>
              </h2>
              <p class="desc">{p.frontmatter.description}</p>
            </div>

            <div class="tags">
              {p.frontmatter.tags.map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>

            <span class="date">
              {p.frontmatter.publicationDate} (
              {getDaysAgoSince(parseDate(p.frontmatter.publicationDate))})
            </span>
          </Board>
        ))}
      </div>
    </div>

    <div style={{ width: "80vw" }}>
      <Header text="Tech Stack" />

      <div class="tech-cont">
        {TeckStack.map((t) => (
          <div class="tech-board">
            <h3>{t.title}</h3>
            <ul>
              {t.list.map((e) => (
                <li>{e}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  #content {
    position: relative;
    padding: 0px 2rem 2rem;
    display: flex;
    flex-direction: column;
    place-items: center;
    gap: 5rem;
  }
  p {
    font-size: 1.2rem;
  }

  .contacts-cont {
    margin-top: 1rem;
    flex-wrap: wrap;
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 20px;
  }
  .contact-board {
    display: flex;
    height: 2rem;
    align-items: center;
    gap: 5px;
  }

  .tech-cont {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 1rem;
    justify-items: center;
  }
  .tech-board {
    padding: 20px 0px;
  }
  .tech-board h3 {
    font-size: 0.85rem;
    justify-self: start;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg3);
    margin: 0 0 1.2rem 0;
  }
  .tech-board ul {
    list-style: none;
    display: flex;
    padding: 0;
    padding-left: 0.4rem;
    flex-direction: column;
    gap: 0.35rem;
  }
  .tech-board li {
    font-size: 0.95rem;
    color: var(--fg);
  }

  .latest-posts-cont {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    justify-items: stretch;
    margin-top: 1rem;
  }

  .latest-posts-board {
    display: flex;
    flex-direction: column;
    min-height: 190px;
    padding: 15px;
    justify-content: space-between;

    h2 {
      margin: 0;
      font-size: 1.3rem;
    }

    .desc {
      color: var(--fg2);
      margin: 0;
      margin-top: 10px;
      font-size: 1.1rem;
    }

    .tags {
      padding: 1rem 0rem;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;

      .tag {
        padding: 0.4rem 0.9rem;
        color: var(--fg2);
        font-size: 0.95rem;
        background-color: var(--bg4);
      }
    }

    .date {
      font-size: 0.85rem;
      color: var(--fg3);
    }
  }

  @media (max-width: 600px) {
    #content {
      padding: 0px 10px;
    }
    .latest-posts-cont {
      grid-template-columns: repeat(1, 1fr);
    }
  }
</style>

<script>
  fetch("/w/get-ip")
    .then((resp) => {
      if (resp.status == 200) return resp.text();
      else return null;
    })
    .then((d) => {
      if (!d) return;
      const e = document.querySelector(".hero-header");
      if (e) {
        e.textContent = "Hey there, " + d;
      }
    });
</script>

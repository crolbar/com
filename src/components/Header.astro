---
import Theme from "../lib/theme.ts";
const { className = "header", text, ...props } = Astro.props;
---

<div class="cont" {...props}>
  <h1 class={className}>{text}</h1>
  <div
    style={{
      width: "100%",
      height: "1px",
      "background-color": Theme.bg4,
    }}
  />
</div>

<style>
  .cont {
    margin: "15px";
    max-width: 100vw;
  }
  h1 {
    margin: "5px";
    color: var(--fg);
    text-align: center;
    overflow-wrap: break-word;
  }
</style>
